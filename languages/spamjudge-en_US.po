msgid "日志保留时长，过期日志将自动删除"
msgstr "Log retention period; expired logs will be automatically deleted"

#: admin/class-admin-settings.php:584
msgid "检测为垃圾评论后对访客的提醒"
msgstr "Reminder to visitors after detecting spam comments"

#: admin/class-admin-settings.php:590
msgid "当评论被AI检测为垃圾评论时显示给访客的提醒文字，留空则不提醒"
msgstr ""
"When a comment is detected by AI as spam, this is the warning message "
"displayed to visitors. Leave blank to disable the warning"

#: admin/class-admin-settings.php:598
msgid "检测失败后对访客的提醒"
msgstr "Reminder to visitors after detection failure"

#: admin/class-admin-settings.php:604
msgid "当AI检测失败（API错误、超时等）时显示给访客的提醒文字，留空则不提醒"
msgstr ""
"When AI detection fails (API errors, timeouts, etc.), display this alert "
"text to visitors. Leave blank to suppress the alert"

#: admin/class-admin-settings.php:648
msgid "权限不足"
msgstr "Insufficient permissions"

