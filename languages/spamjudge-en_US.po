msgid "表单验证失败："
msgstr "Form validation failed:"

#: admin/class-admin-settings.php:191
msgid "系统提示词不能为空"
msgstr "The system prompt cannot be left blank"

#: admin/class-admin-settings.php:192
msgid "分数阈值必须在 0-100 之间"
msgstr "The score threshold must be between 0 and 100"

#: admin/class-admin-settings.php:193
msgid "超时时间必须至少为 5 秒"
msgstr "The timeout period must be at least 5 seconds"

#: admin/class-admin-settings.php:205
msgid "您没有权限访问此页面"
msgstr "You do not have permission to access this page"

#: admin/class-admin-settings.php:221
msgid "日志"
msgstr "Log"

